{
  "name": "ostriv",
  "version": "1.0.3",
  "description": "Land Management Desktop App",
  "main": "main.js",
  "scripts": {
    "electron": "electron . --no-sandbox",
    "electron:wpd": "electron wpd/main.js --no-sandbox",
    "electron:dev": "electron . --no-sandbox --inspect",
    "electron:dev:admin": "electron . --role=admin --no-sandbox --inspect",
    "build:electron:win": "electron-builder --win --x64",
    "build:electron:wpd:win": "electron-builder --win --config wpd/electron-builder.wpd.json",
    "build:electron:linux": "electron-builder --linux",
    "build:win": "bash build-win.sh"
  },
  "build": {
    "appId": "com.land-management.app",
    "productName": "Land Management",
    "publish": {
      "provider": "github",
      "owner": "IntDavydov",
      "repo": "extract-parcels"
    },
    "files": [
      "**/*",
      "!kadastr.exe",
      "!*.bat",
      "!build-win.sh",
      "!win-node/",
      "!oster_plots.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage"
    },
    "asar": false
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@mapbox/togeojson": "^0.16.2",
    "@mapbox/vector-tile": "^2.0.4",
    "@turf/bbox": "^7.3.4",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/buffer": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "@turf/intersect": "^7.3.4",
    "@turf/simplify": "^7.3.4",
    "@turf/union": "^7.3.4",
    "docx": "^9.6.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "extract-zip": "^2.0.1",
    "geotiff": "^3.0.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "osm-pbf-parser": "^2.3.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "pbf": "^4.0.1",
    "pptxgenjs": "^3.12.0",
    "puppeteer": "^24.37.5",
    "vector-tile": "^1.3.0"
  },
  "devDependencies": {
    "caxa": "^3.0.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1"
  }
}
