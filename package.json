{
  "name": "ostriv",
  "version": "1.0.0",
  "description": "Land Management Desktop App",
  "main": "main.js",
  "scripts": {
    "electron": "electron . --no-sandbox",
    "electron:dev": "electron . --no-sandbox --inspect",
    "build:electron:win": "electron-builder --win",
    "build:electron:linux": "electron-builder --linux",
    "build:win": "bash build-win.sh"
  },
  "build": {
    "appId": "com.land-management.app",
    "productName": "Land Management",
    "files": [
      "**/*",
      "!kadastr.exe",
      "!*.bat",
      "!build-win.sh",
      "!win-node/",
      "!oster_plots.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage"
    },
    "asarUnpack": [
      "script.js",
      "gui.html",
      "src/**",
      "houses.png",
      "windmill.png",
      "node_modules/**"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "@turf/buffer": "^7.3.4",
    "@turf/union": "^7.3.4",
    "geotiff": "^3.0.3",
    "jszip": "^3.10.1",
    "osmtogeojson": "^3.0.0-beta.5",
    "pbf": "^4.0.1",
    "puppeteer": "^24.37.5",
    "vector-tile": "^1.3.0"
  },
  "devDependencies": {
    "caxa": "^3.0.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1"
  }
}
